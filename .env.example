# ==========================================
# DevConnect Monorepo Environment Variables
# ==========================================
# See server/.env.example and client/.env.example for package-specific configuration.

# Backend (server/.env)
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devconnect?schema=public
JWT_SECRET=replace-with-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-secure-cookie-secret
CLIENT_URL=http://localhost:5173

# Frontend (client/.env)
VITE_API_URL=/api
# Production:
# VITE_API_URL=https://devconnect-server-8oya.onrender.com/api
# VITE_WS_URL=https://devconnect-server-8oya.onrender.com
