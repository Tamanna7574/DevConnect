generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String?
  githubId     String?   @unique
  name         String
  avatarUrl    String?
  bio          String?
  location     String?
  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  projects            Project[]
  blogPosts           BlogPost[]
  userSkills          UserSkill[]
  endorsementsGiven   Endorsement[]  @relation("UserEndorsements")
  sentConnections     Connection[]   @relation("SentConnections")
  receivedConnections Connection[]   @relation("ReceivedConnections")
  notifications       Notification[]

  @@index([email])
  @@index([username])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @db.Text
  techStack   String[]
  githubUrl   String?
  liveDemoUrl String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlogPost {
  id          String    @id @default(uuid())
  authorId    String
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String    @db.Text
  coverImage  String?
  tags        String[]
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([slug])
}

model Skill {
  id        String      @id @default(uuid())
  name      String      @unique
  category  String      @default("OTHER")
  createdAt DateTime    @default(now())
  
  userSkills UserSkill[]

  @@index([name])
}

model UserSkill {
  id                 String        @id @default(uuid())
  userId             String
  skillId            String
  yearsOfExperience  Int?
  createdAt          DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorsements Endorsement[]

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Endorsement {
  id          String   @id @default(uuid())
  userSkillId String
  endorserId  String
  createdAt   DateTime @default(now())

  userSkill UserSkill @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  endorser  User      @relation("UserEndorsements", fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([userSkillId, endorserId])
  @@index([userSkillId])
  @@index([endorserId])
}

model Connection {
  id          String   @id @default(uuid())
  requesterId String
  receiverId  String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String   // CONNECTION_REQUEST, CONNECTION_ACCEPTED, SKILL_ENDORSEMENT, NEW_BLOG_POST
  title      String
  message    String
  entityId   String?
  entityType String?
  isRead     Boolean  @default(false)
  metadata   String?  @db.Text // serialized JSON object
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
